{
  "name": "jsofd",
  "private": true,
  "version": "1.0.0",
  "description": "jsOFD monorepo: packages/core (library) and packages/playground (interactive demo).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @jsofd/playground dev",
    "build": "pnpm --filter @hufe921/jsofd build",
    "publish:npm": "pnpm --filter @hufe921/jsofd publish",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint \"packages/*/src/**/*.ts\" \"packages/*/tests/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"packages/*/src/**/*.ts\" \"packages/*/tests/**/*.ts\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitepress": "^1.6.4"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@12.4.2"
}
